# ignore rules

# junk
*~
__pycache__
.DS_Store

# the default build locations
/builds
/products
build*/

# the developer
.idea

# the sphinx doc build directory
_build
# the sources laid out for the api reference, at docs build time
/docs/_autoapi_src

# the synthetic data from the mogi model
/models/mogi/examples/**/*.txt
/models/mogi/examples/**/*.csv

# the synthetic data from the cdm model
/models/cdm/examples/**/*.txt
/models/cdm/examples/**/*.csv

# the synthetic data from the reverso model
/models/reverso/examples/**/*.txt
/models/reverso/examples/**/*.csv

# auctex lint
/doc/**/auto
# tex lint
/doc/**/*.aux
/doc/**/*.bbl
/doc/**/*.blg
/doc/**/*.log
/doc/**/*.nav
/doc/**/*.out
/doc/**/*.snm
/doc/**/*.toc
/doc/**/*.vrb
# ignore pdfs
/doc/**/*.pdf
# but not those that are figures
!doc/**/figures/*.pdf

# example outputs
pro*.csv
**/examples/sigma.txt
**/examples/theta.txt
**/examples/llk.txt
**/results/
**/*_results/
BetaStatistics.txt

# availabel upon request, due to large sizes
models/seismic/examples/kinematicG_9patch/

# end of file
