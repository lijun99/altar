;
; generate the input files first, in {synthetic}:
;     cd synthetic && python3 cdm.py
; then sample with
;     cdm --config=cdm.pfg

cdm:
    ; shell
    ; shell = mpi.shells.mpirun ; for running with mpi

    controller = altar.bayesian.catmip
    controller.archiver = altar.bayesian.h5recorder
    controller.archiver.output_dir = results
    ; no covariance conditioning: its eigenvalue floor swamps the small-scale parameters
    ; (offsets) with the spread of the large-scale ones (locations, axes)
    controller.scheduler.check_positive_definiteness = False
    controller.sampler.proposal.check_positive_definiteness = False

    ; job layout
    job:
        tasks = 1       ; number of tasks per host
        gpus = 1        ; number of gpus per task
        chains = 2**12  ; number of chains per task
        steps = 20      ; the length of each chain

    ; model configuration
    model:
        case = synthetic
        ; the cpu engine: native (python) or fast (c++)
        mode = fast

        ; the observed LOS displacements, from two tracks
        dataobs:
            observations = 338
            data_file = data.txt
            cd_file = cd.txt

        ; parameter sets
        psets_list = [location, depth, opening, a, omega, offsets]
        psets:
            location = contiguous
            depth = contiguous
            opening = contiguous
            a = contiguous
            omega = contiguous
            offsets = contiguous

            location:
                count = 2
                prior = uniform
                prior.support = (-3000, 3000)
            depth:
                count = 1
                prior = uniform
                prior.support = (1000, 6000)
            ; in m
            opening:
                count = 1
                prior = uniform
                prior.support = (0, 10)
            ; the semi-axes, in m
            a:
                count = 3
                prior = uniform
                prior.support = (0, 2000)
            ; the rotations about the x, y, z axes, in degrees
            omega:
                count = 3
                prior = uniform
                prior.support = (-45, 45)
            offsets:
                count = 2
                prior = uniform
                prior.support = (-0.1, 0.1)


; for parallel runs
mpi.shells.mpirun # altar.plexus.shell:
    extra = -mca btl self,tcp

; end of file
