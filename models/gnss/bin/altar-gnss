# get the package
import altar


# the application
class GNSS(altar.shells.application, family='altar.applications.gnss'):
    """
    A specialized AlTar application for the trajectory models of GNSS position time series
    """

    # user configurable state
    model = altar.models.model(default='altar.models.gnss.trajectory')
    model.doc = "the AlTar model to sample"


if __name__ == "__main__":
    # build an instance of the default app
    app = GNSS(name="gnss")
    # invoke the main entry point
    status = app.run()
    # share
    raise SystemExit(status)


# end of file
