;
; CPU HMC sampling directly at beta=1 (no annealing ladder): {annealer} defaults to the
; {ConstantTemperature} scheduler, which jumps straight to beta=1 in a single step, so all of
; {job.steps} trajectories are spent sampling the actual posterior instead of a beta ladder
;

; the linear app
linear:
    ; test case configuration
    model:
        ; the name of the test case
        case = patch-9
        ; the number of free parameters
        parameters = 18
        ; observed data
        dataobs:
            observations = 108
            cd_file = cd.txt

        ; a single parameter set covering the whole vector
        psets_list = [all]
        psets:
            all = contiguous
            all:
                count = {linear.model.parameters}
                prep = gaussian
                prep.sigma = 0.5
                prior = gaussian
                prior.sigma = 0.5


    controller = altar.bayesian.annealer
    controller:
        sampler = altar.bayesian.hmc
        sampler:
            leapfrog_steps = 10
            step_size = 0.01

    ; run configuration
    job.tasks = 1 ; number of tasks per host
    job.gpus = 0  ; number of gpus per task
    job.chains = 2**8 ; number of chains per task
    job.steps = 200 ; number of hmc trajectories at beta=1

; end of file
