;
; the regression of linear.pfg, sampled with HMC, through the gradient of the model; sample with
;     altar-regression --config=linear_hmc.pfg

; regression model
regression:

    controller = altar.bayesian.catmip_hmc
    controller.archiver = altar.bayesian.h5recorder
    controller.archiver.output_dir = results_hmc

    ; job layout
    job:
        tasks = 1       ; number of tasks per host
        gpus = 0        ; number of gpus per task
        chains = 2**10  ; number of chains per task
        steps = 20      ; the number of hmc trajectories per beta step

    ; model configuration
    model = altar.models.regression.linear
    model:
        case = synthetic
        x_file = x.txt

        ; the observed y, with the standard deviation of their noise
        dataobs:
            observations = 200
            data_file = y.txt
            cd_std = 0.2

        ; parameter sets; HMC needs unbounded priors, so the uniform ones are reparameterized
        psets_list = [slope, intercept]
        psets:
            slope = contiguous
            intercept = contiguous

            slope:
                count = 1
                prep = uniform
                prep.support = (0, 5)
                prior = uniform
                prior.support = (0, 5)
                prior.reparameterize = True

            intercept:
                count = 1
                prep = uniform
                prep.support = (0, 5)
                prior = uniform
                prior.support = (0, 5)
                prior.reparameterize = True

; end of file
