;
; generate the input files first, in {synthetic}:
;     cd synthetic && python3 reverso.py
; then sample with
;     altar-reverso --config=reverso.pfg

reverso:
    ; shell
    ; shell = mpi.shells.mpirun ; for running with mpi

    controller = altar.bayesian.catmip
    controller.archiver = altar.bayesian.h5recorder
    controller.archiver.output_dir = results
    ; no covariance conditioning: its eigenvalue floor swamps the small-scale parameters
    ; (Qin, a_c) with the spread of the large-scale ones (depths, radii)
    controller.scheduler.check_positive_definiteness = False
    controller.sampler.proposal.check_positive_definiteness = False

    ; job layout
    job:
        tasks = 1       ; number of tasks per host
        gpus = 0        ; number of gpus per task
        chains = 2**12  ; number of chains per task
        steps = 20      ; the length of each chain

    ; model configuration
    model:
        case = synthetic
        ; the cpu engine: native (python) or fast (c++)
        mode = fast
        ; the shapes of the chambers: sill or sphere
        shallow = sill
        deep = sill

        ; the observed (east, north, up) displacements of 35 observations
        dataobs:
            observations = 105
            data_file = data.txt
            cd_file = cd.txt

        ; parameter sets
        psets_list = [Qin, H_s, H_d, a_s, a_d, a_c]
        psets:
            Qin = contiguous
            H_s = contiguous
            H_d = contiguous
            a_s = contiguous
            a_d = contiguous
            a_c = contiguous

            ; the basal inflow rate, in m^3/s
            Qin:
                count = 1
                prior = uniform
                prior.support = (.4, .8)
            ; the chamber depths and radii, in m
            H_s:
                count = 1
                prior = uniform
                prior.support = (2500, 3500)
            H_d:
                count = 1
                prior = uniform
                prior.support = (3500, 4500)
            a_s:
                count = 1
                prior = uniform
                prior.support = (1500, 2500)
            a_d:
                count = 1
                prior = uniform
                prior.support = (1500, 2500)
            ; the conduit radius, in m
            a_c:
                count = 1
                prior = uniform
                prior.support = (1, 2)


; for parallel runs
mpi.shells.mpirun # altar.plexus.shell:
    extra = -mca btl self,tcp

; end of file
