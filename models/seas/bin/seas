# get the package
import altar


# make a specialized app that uses the 3d seas model by default
class SEAS(altar.shells.application, family='altar.applications.seas'):
    """
    An AlTar application for Sequences of Earthquakes and Aseismic Slip (SEAS) models
    """

    # user configurable state
    model = altar.models.model(default='altar.models.seas.seas3d')
    model.doc = "the AlTar model to sample"


# bootstrap
if __name__ == "__main__":
    # build an instance of the default app
    app = SEAS(name="seas")
    # invoke the main entry point
    status = app.run()
    # share
    raise SystemExit(status)


# end of file
