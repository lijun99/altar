# get the package
import altar


# the plexus of the SEAS models: the actions, e.g. optimize, forward or resolution
class SEASPlexus(altar.shells.altar, family='altar.shells.seas'):
    """
    The actions for Sequences of Earthquakes and Aseismic Slip (SEAS) models
    """

    # user configurable state
    model = altar.models.model(default='altar.models.seas.seas3d')
    model.doc = "the AlTar model"


# main
if __name__ == "__main__":
    # build an instance of the plexus, under the name of the application, so it shares its settings
    app = SEASPlexus(name="seas")
    # invoke the main entry point
    status = app.run()
    # share
    raise SystemExit(status)


# end of file
