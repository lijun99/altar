; for Bayesian simulations, run
;        altar_seas --config=seas.pfg

; the application
seas:

    ; the model
    model = altar.models.seas.cuda.linearviscous
    model:

        ; the path of input files
        case = linearviscous_strike

        ; model parameters
        patches = 8 ; creeping zone patches
        t_period = (0.0, 1.0) ; earthquake cycle period
        stations = 10 ; # of surface observation stations
        t_eval_points = 10 ; # of t_eval points


        ; input files
        t_eval_file = t_eval.txt ; # time points to be evaluated
        stress_kernel_file = stresskernel.txt ; K (patches, patches)
        displacement_kernel_file = displacementkernel.txt ; G (patches, stations)
        coseismic_file = coseismic.txt ; coseismic change to (slip, stress) 2*patches


        ; data observations (timesxstations)
        dataobs:
             observations = {seas.model.t_eval_points}*{seas.model.stations}
             data_file = displacements.txt ; (t_eval_points, stations) flattened
             cd_std = 1e-2 ; or cd_file

        ; parameters to be simulated
        ; provide a list at first, serving as their orders in theta
        psets_list = [viscous_coef]

        ; define each parameterset
        psets:
            viscous_coef = altar.cuda.models.parameterset

            ; variables
            viscous_coef:
                count = 1 ; same for all patches
                prior = altar.cuda.distributions.uniform
                prior.support = (0.01, 0.2)





    ; controller/annealer
    controller:
        sampler = altar.cuda.bayesian.metropolis
        archiver:
            output_dir = results ; results output directory
            output_freq = 3 ; output frequency of annealing steps

    ; monitors, comment out if you don't need profiling
    monitors:
        prof = altar.bayesian.profiler

    ; run configuration
    job.tasks = 1 ; number of tasks per host
    job.gpus = 1  ; number of gpus per task/thread
    ;job.gpuids = [0 1] ; gpu slots to be occupied
    job.gpuprecision = float32 ; desired precision for gpu (float64 or float32)
    job.chains = 2**8 ; number of chains per task
    job.steps = 500

    ; shell
    ; shell = mpi.shells.mpirun ; for running with mpi


; for parallel runs
; mpi.shells.mpirun # altar.plexus.shell:
;     extra = -mca btl self,tcp

; end of file
