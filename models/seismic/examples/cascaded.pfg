; the cascaded static-kinematic inversion example; cuda only, for its kinematic model
;
; 1. solve the static model first, e.g.
;        slipmodel.plexus sample --config=static.pfg
;    9patch/theta_cascaded.h5 holds such a static posterior; to use your own instead, set the
;    slips' prep.input_file below to results/static/step_final.h5
; 2. then sample the ensemble {static, kinematic}, the slips starting from the static
;    posterior; the static model contributes at beta = 1 throughout (cascaded), while the
;    kinematic one is annealed
;        slipmodel.plexus sample --config=cascaded.pfg
; 3. and compare each model's predicted data to its observed data with
;        slipmodel.plexus forward --config=cascaded.pfg
; the kinematic green's functions (kinematicG.gf.h5) are too large for github; see 9patch/NOTE

slipmodel:

    ; an ensemble of models sharing one set of parameters
    model = altar.models.ensemble
    model:

        ; the directory with the preset samples
        case = 9patch

        ; number of patches, Nas*Ndd
        patches = 9

        ; the parameters, shared by the models below
        psets_list = [strikeslip, dipslip, risetime, rupturevelocity, hypocenter]

        psets:
            strikeslip = contiguous
            dipslip = contiguous
            risetime = contiguous
            rupturevelocity = contiguous
            hypocenter = contiguous

            strikeslip:
                count = {slipmodel.model.patches}
                ; start from the static posterior
                prep = preset
                prep.input_file = theta_cascaded.h5
                prep.dataset = ParameterSets/strikeslip
                prior = gaussian
                prior.mean = 0
                prior.sigma = 0.5

            dipslip:
                count = {slipmodel.model.patches}
                ; start from the static posterior
                prep = preset
                prep.input_file = theta_cascaded.h5
                prep.dataset = ParameterSets/dipslip
                prior = uniform
                prior.support = (-0.5, 20.0)

            risetime:
                count = {slipmodel.model.patches}
                prior = uniform
                prior.support = (10.0, 30.0)

            rupturevelocity:
                count = {slipmodel.model.patches}
                prior = uniform
                prior.support = (1.0, 6.0)

            hypocenter:
                count = 2
                prior = gaussian
                prior.mean = 20.0
                prior.sigma = 5.0

        ; the models, each on the parameter sets it names
        models:
            static = altar.models.seismic.static
            kinematic = altar.models.seismic.kinematic

            static:
                ; contributes at beta = 1 throughout
                cascaded = True
                case = {slipmodel.model.case}
                psets_list = [strikeslip, dipslip]
                green = static.gf.h5
                dataobs:
                    observations = 108
                    data_file = static.data.h5
                    cd_file = static.Cd.h5

            kinematic:
                case = {slipmodel.model.case}
                psets_list = [strikeslip, dipslip, risetime, rupturevelocity, hypocenter]
                green = kinematicG.gf.h5
                dataobs:
                    observations = 14148
                    data_file = kinematicG.data.h5
                    cd_std = 5.0e-3
                Nas = 3 ; patches along strike
                Ndd = 3 ; patches along dip
                Nmesh = 30 ; mesh points for each patch
                dsp = 20.0 ; length for each patch, km
                Nt = 90 ; number of time intervals
                Npt = 2 ; mesh points for each time interval
                dt = 1.0 ; time unit for each interval, second
                t0s = [0.0] * {slipmodel.model.patches}

    controller = altar.bayesian.catmip
    controller:
        archiver = altar.bayesian.h5recorder
        archiver:
            output_dir = results/cascaded ; output directory
            output_freq = 3 ; output frequency in beta steps

    ; the forward check, on the final archived step
    forward:
        theta = results/cascaded/step_final.h5
        output = results/cascaded/forward.h5

    ; run configuration
    job:
        tasks = 1 ; number of tasks per host
        gpus = 1  ; number of gpus per task
        ; float32 loses the chains here: acceptance collapses to zero part way through annealing
        gpuprecision = float64 ; double(float64) or single(float32) precision for gpu computations
        chains = 2**10 ; number of chains per task
        steps = 500 ; MC burn-in steps for each beta step

; end of file
