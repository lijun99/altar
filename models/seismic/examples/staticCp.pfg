; the static inversion example with a model uncertainty C_p
;
; sample with
;        slipmodel.plexus sample --config=staticCp.pfg
; then compare the posterior's predicted data to the observed data with
;        slipmodel.plexus forward --config=staticCp.pfg

slipmodel:

    ; the static model is the linear model d = G theta
    model = altar.models.seismic.static
    model:

        ; the name of the test case, also as directory for input files
        case = 9patchCp

        ; number of patches
        patches = 9

        ; green's function (observations, parameters)
        green = static.gf.h5

        ; data observations - use L2 norm for likelihood
        dataobs:
            observations = 168
            data_file = static.data.h5
            cd_file = static.Cd.h5
            cd_dtype = float64 ; factor C_chi = C_d + C_p in double precision

        ; the model uncertainty C_p, re-estimated from the posterior mean at each beta step:
        ; C_p = K_p C_mu K_p^T, K_p[:, i] = K_i theta_mean
        cp = altar.models.cp.adaptive
        cp:
            start = 0.01 ; include C_p once beta reaches this value
            initial_model = static.initialModel.h5 ; the mean model to use early on ...
            initial_until = 0 ; ... while beta <= this value
        ; the covariance of the uncertain elastic structure, and the green's functions'
        ; sensitivity to each of its components, dG/dmu_i
        cmu_file = static.Cmu.h5
        kmu_file = static.kernel.h5

        ; list of parametersets
        ; the order should be consistent with the green's function
        psets_list = [strikeslip, dipslip]

        ; define parametersets
        psets:
            strikeslip = contiguous
            dipslip = contiguous

            strikeslip:
                count = {slipmodel.model.patches}
                prior = gaussian
                prior.mean = 0
                prior.sigma = 0.7

            dipslip:
                count = {slipmodel.model.patches}
                prior = altar.models.seismic.moment
                prior:
                    support = (-0.5, 10) ; slip range
                    Mw_mean = 7.0
                    Mw_sigma = 0.5
                    Mu = [30] ; in GPa
                    area = [3600] ; patch area in km^2

    controller = altar.bayesian.catmip
    controller:
        archiver = altar.bayesian.h5recorder
        archiver:
            output_dir = results/staticCp ; output directory
            output_freq = 3 ; output frequency in beta steps

    ; the forward check, on the final archived step
    forward:
        theta = results/staticCp/step_final.h5
        output = results/staticCp/forward.h5

    ; run configuration
    job:
        tasks = 1 ; number of tasks per host
        gpus = 0  ; number of gpus per task
        gpuprecision = float32 ; double(float64) or single(float32) precision for gpu computations
        chains = 2**10 ; number of chains per task
        steps = 100 ; MC burn-in steps for each beta step

; end of file
