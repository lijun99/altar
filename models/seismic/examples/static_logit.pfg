; the static inversion example with HMC: bounded dip slips are sampled in an unbounded
; logit space ({reparameterize}), as gradient-based samplers require
;
; sample with
;        slipmodel.plexus sample --config=static_logit.pfg
; then compare the posterior's predicted data to the observed data with
;        slipmodel.plexus forward --config=static_logit.pfg

slipmodel:

    ; the static model is the linear model d = G theta
    model = altar.models.seismic.static
    model:

        ; the name of the test case, also as directory for input files
        case = 9patch

        ; number of patches
        patches = 9
        ; strike and dip slip for each patch
        parameters = 2*{slipmodel.model.patches}

        ; green's function (observations, parameters)
        green = static.gf.h5

        ; data observations - use L2 norm for likelihood
        dataobs:
            observations = 108
            data_file = static.data.h5
            cd_file = static.Cd.h5

        ; list of parametersets
        ; the order should be consistent with the green's function
        psets_list = [strikeslip, dipslip]

        ; define parametersets
        psets:
            strikeslip = contiguous
            dipslip = contiguous

            strikeslip:
                count = {slipmodel.model.patches}
                prior = gaussian
                prior.mean = 0
                prior.sigma = 0.5

            dipslip:
                count = {slipmodel.model.patches}
                prior = altar.models.seismic.moment
                prior:
                    support = (-0.5, 20) ; slip range
                    Mw_mean = 7.3
                    Mw_sigma = 0.2
                    Mu = [30] ; in GPa
                    area = [400] ; patch area in km^2
                    moment_constraint = True ; add a gaussian penalty on the total Mw to the prior
                    moment_constraint_factor = 1.0 ; weight of the penalty
                    reparameterize = True ; sample logit(slip) instead of slip

    controller = altar.bayesian.catmiphmc
    controller:
        sampler:
            leapfrog_steps = 10
            step_size = 0.01
        archiver = altar.bayesian.h5recorder
        archiver:
            output_dir = results/static_logit ; output directory
            output_freq = 3 ; output frequency in beta steps

    ; the forward check, on the final archived step
    forward:
        theta = results/static_logit/step_final.h5
        output = results/static_logit/forward.h5

    ; run configuration
    job:
        tasks = 1 ; number of tasks per host
        gpus = 1  ; number of gpus per task
        gpuprecision = float64 ; double(float64) or single(float32) precision for gpu computations
        chains = 2**10 ; number of chains per task
        steps = 20 ; hmc trajectories per beta step

; end of file
