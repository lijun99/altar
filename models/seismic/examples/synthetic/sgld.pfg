; the static uoᴉsɹǝʌuᴉ example
;
; for Bayesian simulations, run
;        slipmodel --config=static.pfg
;   or   slipmodel.plexus sample --config=static.pfg
; for forward problem only (with an input set of parameters), run
;        slipmodel.plexus forward --config=static.pfg


; my shell application
slipmodel = altar.shells.altar
slipmodel:

    ; model to be sampled
    model = altar.models.seismic.cuda.static
    model:

        ; the name of the test case, also as directory for input files
        case = synthetic

        ; number of patches
        patches = 8

        ; green's function (observations, parameters)
        green = green.txt

        ; data observations - use L2 norm for likelihood
        dataobs = altar.cuda.data.datal2
        dataobs:
            observations = 2*{slipmodel.model.patches}
            data_file = data.txt
            cd_std = 0.1

        ; list of parametersets
        ; the order should be consistent with the green's function
        psets_list = [strikeslip, dipslip]

        ; define parametersets
        psets:
            strikeslip = altar.cuda.models.parameterset
            dipslip = altar.cuda.models.parameterset

            strikeslip:
                count = {slipmodel.model.patches}
                prior = altar.cuda.distributions.gaussian
                prior.mean = 0
                prior.sigma = 5

            dipslip:
                count = {slipmodel.model.patches}
                prior = altar.cuda.distributions.uniform
                prior:
                    support = (-0.5, 1.5) ; slip range

    controller = altar.bayesian.langevin
    controller:
        tsteps = 10000
        tsteps_report = 10
        sweeps = 100

        scheduler = altar.bayesian.powerdecay
        scheduler:
             a = 0.1/{slipmodel.model.dataobs.observations}
             b = 10
             gamma = 0.33

        ;scheduler = altar.bayesian.expdecay
        ;scheduler:
        ;     a = 0.01/{slipmodel.model.dataobs.observations}
        ;     b = 0.01

    ; run configuration
    job:
        tasks = 1 ; number of tasks per host
        gpus = 1  ; number of gpus per task
        gpuprecision = float32 ; double(float64) or single(float32) precision for gpu computations
        ;gpuids = [0] ; a list gpu device ids for tasks on each host, default range(job.gpus)
        chains = 2**8 ; number of chains per task
        steps = 1000 ; MC burn-in steps for each beta step

    ; shell
    ; shell = mpi.shells.mpirun ; for running with mpi


; for parallel runs
; mpi.shells.mpirun # altar.plexus.shell:
    ; extra = -mca btl self,tcp

; end of file
